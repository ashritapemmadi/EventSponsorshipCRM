@model EventSponsorshipCRM.Models.Lead

@{
    ViewData["Title"] = "Add Lead";
}

<div class="container mt-4">

    <h2>Add Potential Sponsor</h2>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Lead Code</label>
            <input asp-for="LeadCode" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Contact Name</label>
            <input asp-for="LeadName" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Company Name</label>
            <input asp-for="CompanyName" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Phone</label>
            <input asp-for="Phone" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Source</label>
            <select asp-for="Source" class="form-control">
                <option value="">Select Source</option>
                <option>Email</option>
                <option>Referral</option>
                <option>Website</option>
                <option>Event</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Status</label>
            <select asp-for="Status" class="form-control">
                <option>New</option>
                <option>Contacted</option>
                <option>Qualified</option>
                <option>Unqualified</option>
                <option>Converted</option>
                <option>Lost</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Expected Sponsorship Value</label>
            <input asp-for="ExpectedValue" type="number" step="0.01" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            Save Lead
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>